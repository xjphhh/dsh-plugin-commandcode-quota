{
  "name": "@local/commandcode-quota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: Command Code plan quota (5-hour, weekly, monthly) and today's token spend in the composer dock.",
  "license": "MIT",
  "author": "xjphhh",
  "homepage": "https://github.com/xjphhh/dsh-plugin-commandcode-quota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xjphhh/dsh-plugin-commandcode-quota.git"
  },
  "bugs": {
    "url": "https://github.com/xjphhh/dsh-plugin-commandcode-quota/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "command-code",
    "commandcode",
    "quota",
    "usage",
    "credits"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "Command Code 额度",
    "description": "在输入框下方显示 Command Code 的 5 小时 / 本周 / 本月剩余额度与本周期的请求次数。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
